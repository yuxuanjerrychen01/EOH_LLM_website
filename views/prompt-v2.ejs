<!DOCTYPE html>
<html>
<head>
    <title>Decorate the Website</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body, html { 
            margin: 0; padding: 0; height: 100%; 
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            overflow: hidden;
        }

        /* Animated background */
        .gradient-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            z-index: 1;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            width: 90%;
            max-width: 500px;
            margin: 15vh auto;
            padding: 40px 30px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            text-align: center;
        }

        h1 { color: #333; margin-bottom: 10px; font-size: 1.8em; }
        p { color: #666; margin-bottom: 30px; line-height: 1.5; }

        .input-group {
            position: relative;
            margin-bottom: 20px;
        }

        /* password input styling */
        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 15px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            box-sizing: border-box;
            transition: border-color 0.3s;
            outline: none;
        }

        input[type="text"]:focus, input[type="password"]:focus {
            border-color: #23a6d5;
        }

        button {
            background: #23a6d5;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 10px;
            cursor: pointer;
            width: 100%;
            transition: transform 0.2s, background 0.3s;
        }

        button:hover {
            background: #1c8cb5;
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

        /* Simple loading state when form is submitted */
        .loading-text { display: none; margin-top: 15px; color: #666; font-style: italic; }
    </style>
</head>
<body>

    <div class="gradient-bg"></div>

    <div class="container">
        <h1>Decorate a website using AI!</h1>

        <!-- show login box if not authenticated -->
        <% if (!authed) { %>
            <p>EOH volunteer login</p>

            <div id="login-box">
                <div class="input-group">
                    <input type="password" id="passwordInput" placeholder="Enter password" required autofocus>
                </div>

                <button onclick="login()" id="loginBtn">Enter</button>
            </div>
        <% } else { %>
            <p>What do you want the website to look like?</p>

            <div id="prompt-form-container">
                <div class="input-group">
                    <input type="text" id="promptInput" placeholder="e.g. Fighting Illini final four theme" required autofocus>
                </div>

                <button onclick="submitPrompt()" id="submitBtn">Decorate Page</button>
                <div id="loader" class="loading-text">Asking AI to decorate the page...</div>
                <div id="successBox" class="success-msg"></div>
            </div>
            
            <p style="margin-top: 30px; font-size: 0.8em;">
                <a href="/results" target="_blank" style="color: #23a6d5; text-decoration: none;">click here to see changes</a>
            </p>
        <% } %>
    </div>

    <script>
        async function login() {
            const passwordInput = document.getElementById('passwordInput');

            if (!passwordInput.value) return alert("Enter password");

            const response = await fetch('/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password: passwordInput.value })
            });

            if (response.ok) {
                location.reload();
            } else {
                alert('Wrong password');
            }
        }

        async function submitPrompt() {
            const promptInput = document.getElementById('promptInput');
            const submitBtn = document.getElementById('submitBtn');
            const loader = document.getElementById('loader');
            const successBox = document.getElementById('successBox');

            if (!promptInput.value) return alert("Please enter a prompt!");

            // UI Loading
            submitBtn.style.display = 'none';
            loader.style.display = 'block';
            successBox.style.display = 'none';

            try {
                const response = await fetch('/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: promptInput.value })
                });

                const result = await response.json();

                if (result.success) {
                    // UI Success
                    loader.style.display = 'none';
                    successBox.style.display = 'block';
                    promptInput.value = ''; // Clear input for next user
                    
                    setTimeout(() => {
                        successBox.style.display = 'none';
                        submitBtn.style.display = 'block';
                    }, 3000);
                }
            } catch (err) {
                alert("Something went wrong.");
                submitBtn.style.display = 'block';
                loader.style.display = 'none';
            }
        }
    </script>

</body>
</html>