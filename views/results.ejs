<!DOCTYPE html>
<html>
<head>
    <title>Results</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100svh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* Background Layer */
        .ai-background { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            z-index: 1; overflow: hidden; 
        }
        
        /* Survey Card */
        #survey-container {
            position: relative;
            z-index: 10;
            width: min(92vw, 500px);
            max-height: 80svh;
            overflow-y: auto;
            padding: 20px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            text-align: center;
            box-sizing: border-box;
        }

        .chart-wrapper {
            position: relative;
            margin: 10px auto 10px auto;
            width: 100%;
            height: 220px;
            max-height: 220px;
        }

        .hidden { display: none; }
        
        h2, h3 { margin-top: 0; color: #333; }
        label { display: block; margin-top: 15px; font-weight: bold; color: #555; font-size: 16px; }
        
        select, button { 
            width: 100%; padding: 12px; margin-top: 8px; 
            border-radius: 8px; border: 1px solid #ddd; font-size: 16px;
        }

        .btn-submit { background: #FF5F0F; color: white; border: none; cursor: pointer; font-weight: bold; }
        .btn-skip { background: transparent; color: #666; border: none; cursor: pointer; text-decoration: underline; margin-top: 10px; font-size: 16px; }
        .btn-back { background: #FF5F0F; color: white; border: none; cursor: pointer; font-weight: bold; margin-top: 20px; }
        
        button:hover { opacity: 1; }
    </style>
</head>
<body>

    <div class="ai-background"><%- decoration %></div>

    <div id="survey-container">
        <!-- FORM VIEW -->
        <div id="survey-form">
            <h2>Quick Survey</h2>
            
            <label>Can AI be truly creative?</label>
            <select id="q1">
                <option>Yes, just like humans</option>
                <option>Somewhat, but not fully</option>
                <option>No, it just copies humans</option>
                <option>Not sure</option>
            </select>

            <label>Would you want an AI teacher?</label>
            <select id="q2">
                <option>Yes!</option>
                <option>Maybe for some subjects</option>
                <option>No, I prefer humans</option>
                <option>Not sure</option>
            </select>

            <button class="btn-submit" id="submitBtn">Submit & View Stats</button>
            <button class="btn-skip" id="skipBtn">Skip and just see results</button>
        </div>

        <!-- RESULTS VIEW -->
        <div id="survey-results" class="hidden">
            <h3>EOH Live Stats</h3>
            
            <div class="chart-wrapper"><canvas id="chart1"></canvas></div>
            <div class="chart-wrapper"><canvas id="chart2"></canvas></div>

            <button class="btn-back" onclick="location.href='/results'">Back to Survey</button>
        </div>
    </div>

    <script>
        async function fetchAndShowResults(payload = null) {
            let stats;
            
            if (payload) {
                const response = await fetch('/submit-survey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                stats = await response.json();
            } else {
                const response = await fetch('/submit-survey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({}) // Sending empty body -> skip
                });
                stats = await response.json();
            }
            
            document.getElementById('survey-form').classList.add('hidden');
            document.getElementById('survey-results').classList.remove('hidden');

            renderChart('chart1', 'AI and Creativity', stats.q1);
            renderChart('chart2', 'AI as a Teacher', stats.q2);
        }

        document.getElementById('submitBtn').addEventListener('click', () => {
            const payload = {
                q1: document.getElementById('q1').value,
                q2: document.getElementById('q2').value,
            };
            fetchAndShowResults(payload);
        });

        document.getElementById('skipBtn').addEventListener('click', () => {
            fetchAndShowResults(); // Call without payload
        });

        function renderChart(canvasId, title, dataObj) {
            const ctx = document.getElementById(canvasId).getContext('2d');
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: Object.keys(dataObj),
                    datasets: [{
                        data: Object.values(dataObj),
                        backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40']
                    }]
                },
                options: { 
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { position: 'bottom', labels: { boxWidth: 16, font: { size: 16 } } },
                        title: { display: true, text: title, font: { size: 16 } } 
                    } 
                }
            });
        }
    </script>
</body>
</html>